# 模型配置：默认全部使用 Mock，零 Key 即可运行 demo。
# 配置真实 Key 后自动切换为 OpenAI 兼容接口（智谱 / DeepSeek / Qwen 均可）。

# ---- 对话模型 ----
# glm-4-flash 为智谱免费模型（不绑卡不产生费用）；glm-4.7-flash 也是免费档，高峰期可能限流
LLM_PROVIDER=mock
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4-flash
LLM_TEMPERATURE=0.4

# ---- 视觉模型（报告图片识别）----
# GLM-4.6V-Flash 免费档；配置 LLM_API_KEY 后上传功能自动可用
VISION_MODEL=glm-4.6v-flash

# ---- 向量模型 ----
# local_bge：本地 BGE 中文语义模型（免费离线，首次下载约 90MB）
# mock：哈希向量（无依赖，检索质量明显下降，仅作兜底）
EMBEDDING_PROVIDER=local_bge
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_API_KEY=
EMBEDDING_MODEL=embedding-3
