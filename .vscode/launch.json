{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "后端 FastAPI (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/run.py",
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "justMyCode": false
    },
    {
      "name": "前端 Next.js (dev)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"]
    }
  ],
  "compounds": [
    {
      "name": "前后端一起启动",
      "configurations": ["后端 FastAPI (uvicorn)", "前端 Next.js (dev)"]
    }
  ]
}
